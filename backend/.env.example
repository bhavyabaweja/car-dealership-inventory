# Copy to .env. These values match the database defined in ../docker-compose.yml.
DATABASE_URL="postgresql://car_dealer:car_dealer@localhost:5432/car_dealership_dev"
# Optional: the database the integration tests use (this is the default). Its name must end in _test.
# TEST_DATABASE_URL="postgresql://car_dealer:car_dealer@localhost:5432/car_dealership_test"

# Secret used to sign login tokens. Use a long random value; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-at-least-32-characters"
# Optional: token lifetime (default 1h) and port (default 3000; hosts such as Render set PORT themselves)
# JWT_EXPIRES_IN="1h"
# PORT=3000

# Production only. Sites allowed to call the API from a browser, comma-separated, as scheme + host with no path.
# Leave unset in development: the Vite dev server proxies /api, so the browser sees one origin.
# CORS_ORIGIN="https://your-app.vercel.app"
# Production only, for Neon. DATABASE_URL is then the pooled address (host contains "-pooler") and DIRECT_URL the
# direct one; the API uses the first, migrations (`npm run db:migrate:deploy`) the second. Unset in development.
# DIRECT_URL=""

# Admin account created by `npm run db:seed` (not part of the API). Choose your own;
# the password follows the same rules as registration (8 to 72 bytes).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
