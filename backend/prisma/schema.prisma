// Models are added alongside the feature that needs them, each through a migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model Vehicle {
  id        String   @id @default(uuid())
  make      String
  model     String
  category  String
  /// Exact decimal money, never a float. Must be positive (Vehicle_price_positive).
  price     Decimal  @db.Decimal(10, 2)
  /// Never negative (Vehicle_quantity_non_negative) and never above 1,000,000 (Vehicle_quantity_within_limit). Changed only through atomic increments.
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  /// Always stored lowercase; see the User_email_is_lowercase check in the create_user migration.
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}
